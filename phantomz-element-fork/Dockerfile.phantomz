FROM node:22-bullseye AS builder

WORKDIR /src
COPY . /src

RUN corepack enable && corepack prepare pnpm@latest --activate
RUN pnpm install --frozen-lockfile || pnpm install
RUN VERSION=1.0.0 pnpm --dir apps/web build

# Copy our custom config over the built output
RUN cp /src/apps/web/config.json /src/apps/web/webapp/config.json

# Copy Phantomz theme assets into the build
RUN mkdir -p /src/apps/web/webapp/themes/phantomz && \
    cp -r /src/apps/web/res/themes/phantomz/* /src/apps/web/webapp/themes/phantomz/ 2>/dev/null || true

# If custom icons were generated, copy them in
RUN if [ -d /src/apps/web/res/vector-icons-custom ]; then \
        cp /src/apps/web/res/vector-icons-custom/* /src/apps/web/webapp/vector-icons/ 2>/dev/null || true; \
    fi

# Production image
FROM nginx:alpine

RUN apk add --no-cache jq moreutils

COPY --from=builder /src/apps/web/webapp /usr/share/nginx/html
COPY --from=builder /src/apps/web/docker/nginx-templates/* /etc/nginx/templates/

ENV ELEMENT_WEB_PORT=80

HEALTHCHECK --start-period=5s CMD wget -q --spider http://localhost:${ELEMENT_WEB_PORT}/config.json

EXPOSE 80
